{
  "name": "mobile-video-playwright",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A focused Playwright portfolio sample for a mobile web video player.",
  "scripts": {
    "dev": "vite demo --host 127.0.0.1",
    "build": "vite build demo",
    "preview": "vite preview demo --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
